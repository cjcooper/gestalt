{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "File editor windows (editor.html), one per file",
  "windows": ["editor-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
