{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "about",
  "description": "The About window: version, third-party licenses, and links opened in the browser",
  "windows": ["about"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
