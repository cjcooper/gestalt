{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for workspace windows: the launch window and ones opened later",
  "windows": ["main", "workspace-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
